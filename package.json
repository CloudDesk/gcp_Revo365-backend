    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "pizzip": "^3.1.7",
    "puppeteer-core": "^24.40.0",
    "razorpay": "^2.9.6",
    "redis": "^4.7.0",
    "revo-365_backend": "file:",
    "tsx": "^4.19.1",
