    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "crypto": "^1.0.1",
    "csv-stringify": "^6.5.1",
    "csvtojson": "^2.0.10",
    "docxtemplater": "^3.50.0",
    "dotenv": "^16.4.5",
