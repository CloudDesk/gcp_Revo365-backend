{
  "name": "revo-365_backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "npx tsx src/index",
    "test": "tsx --test src/tests/serviceEstimationStockPolicy.test.ts src/tests/financeFoundation.test.ts src/tests/serviceRequestInvoiceFlow.test.ts",
    "test:service-estimation-stock": "tsx --test src/tests/serviceEstimationStockPolicy.test.ts",
    "test:service-invoice-flow": "tsx --test src/tests/financeFoundation.test.ts src/tests/serviceRequestInvoiceFlow.test.ts",
    "verify:product-stock-api": "npx tsx src/scripts/verifyProductStockApi.ts",
    "build": "tsc",
    "migrate": "node build/scripts/runMigrations.js",
    "migrate:dev": "npx tsx src/scripts/runMigrations.ts",
    "verify:finance-foundation": "npx tsx src/scripts/verifyFinanceFoundation.ts",
    "process:ecommerce-finance": "npx tsx src/scripts/processPendingEcommerceFinance.ts",
    "authgcp": "gcloud auth login",
    "set-project": "gcloud config set project revo-dev-and-test",
    "revo-backend-build": "docker build -t revo365-sit-backend .",
    "revo-backend-tag": "docker tag revo365-sit-backend gcr.io/revo-dev-and-test/revo365-sit-backend",
    "revo-backend-push": "docker push gcr.io/revo-dev-and-test/revo365-sit-backend",
    "revo-backend-deploy": "gcloud run deploy revo365-sit --image gcr.io/revo-dev-and-test/revo365-sit-backend:latest --platform managed --region us-central1 --allow-unauthenticated --port 5600 --service-account revodevbackend@revo-dev-and-test.iam.gserviceaccount.com --execution-environment gen2",
    "full-deploy": "npm run set-project && npm run revo-backend-build && npm run revo-backend-tag && npm run revo-backend-push && npm run migrate && npm run revo-backend-deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PravinRaja22/Revo-365_Backend.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PravinRaja22/Revo-365_Backend/issues"
  },
  "homepage": "https://github.com/PravinRaja22/Revo-365_Backend#readme",
