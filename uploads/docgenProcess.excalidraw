      "isDeleted": false,
      "boundElements": [],
      "updated": 1738816514830,
      "link": null,
      "locked": false,
      "text": "After obtaining the client ID, retrieve the private key. Then, \ngenerate a JWT token using the client ID, private key, \nand username.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After obtaining the client ID, retrieve the private key. Then, \ngenerate a JWT token using the client ID, private key, \nand username.",
