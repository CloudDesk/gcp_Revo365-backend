    {
      "id": "vG56UeJvd0C3q-L4XhtMA",
      "type": "text",
      "x": 771.5506906540517,
      "y": 2095.6927333826575,
      "width": 603.6595458984375,
      "height": 75,
      "angle": 6.280292818429169,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 549780698,
      "version": 524,
      "versionNonce": 329754690,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1738816464510,
      "link": null,
      "locked": false,
      "text": "If the OrgID is available in the Secret Manager, it will return \nthe client ID to proceed further. Otherwise, it will need to s\ntore the client ID and OrgID from the first step.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If the OrgID is available in the Secret Manager, it will return \nthe client ID to proceed further. Otherwise, it will need to s\ntore the client ID and OrgID from the first step.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "63FcALrt0zRA3Skf3mpRK",
