      "updated": 1738816407993,
      "link": null,
      "locked": false,
      "text": "It will validate the payload.\n\n",
      "fontSize": 24.50164434175583,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It will validate the payload.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ZMFLYJZ2Qp6QBPq4NeDNv",
      "type": "text",
      "x": 794.3963005868491,
      "y": 1891.1842136014056,
      "width": 607.919677734375,
      "height": 50,
      "angle": 6.280292818429169,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 746519238,
      "version": 474,
      "versionNonce": 231484034,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1738816427101,
      "link": null,
      "locked": false,
      "text": "Then, based on the OrgID from the payload, it will fetch the \nclient ID from the Secret Manager.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Then, based on the OrgID from the payload, it will fetch the \nclient ID from the Secret Manager.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BE3hqJf4hdvFsQGSog1YX",
      "type": "rectangle",
      "x": 736.7081976495076,
      "y": 2081.047374237089,
      "width": 657.7962184514328,
      "height": 105.25738927337679,
