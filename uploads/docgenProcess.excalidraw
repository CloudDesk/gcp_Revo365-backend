      "updated": 1738817060096,
      "link": null,
      "locked": false,
      "text": "Upon successful validation, the API will store the Org ID as \nthe folder name and the Client ID as the value in the \nSecret Manager.",
      "fontSize": 20.20452216368482,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Upon successful validation, the API will store the Org ID as \nthe folder name and the Client ID as the value in the \nSecret Manager.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
