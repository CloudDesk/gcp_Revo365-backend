      "updated": 1738816773566,
      "link": null,
      "locked": false,
      "text": "Once authorized by Salesforce using the access token, instance \nURL,  and content version, it will download the template from \nthe organization.",
      "fontSize": 20.308235677083335,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Once authorized by Salesforce using the access token, instance \nURL,  and content version, it will download the template from \nthe organization.",
