      "isDeleted": false,
      "boundElements": null,
      "updated": 1738816583944,
      "link": null,
      "locked": false,
      "text": "After storing the access token, create a Google Task that\nruns 5 minutes before the access token's expiry time.",
      "fontSize": 19.908621955841802,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After storing the access token, create a Google Task that runs 5 minutes before the access token's expiry time.",
      "autoResize": false,
      "lineHeight": 1.25
    },
